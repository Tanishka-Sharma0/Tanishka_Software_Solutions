### 8. COMPLETE WORKFLOW TEST (RUN IN ORDER)
### =================================================================

### 8.1 Create Test Employee
# @name workflowEmployee
POST {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Workflow Employee",
    "email": "workflow.emp@test.com",
    "password": "Work@123",
    "role": "employee",
    "phone": "9998887770"
}

@workEmpId = {{workflowEmployee.response.body._id}}

### 8.2 Create Test Client
# @name workflowClient
POST {{baseUrl}}/api/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Workflow Client",
    "email": "workflow.client@test.com",
    "password": "Work@123",
    "role": "client",
    "companyName": "Workflow Inc",
    "phone": "8887776660"
}

@workClientId = {{workflowClient.response.body._clientId}}

### 8.3 Login as Test Client
# @name workflowClientLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "workflow.client@test.com",
    "password": "Work@123"
}

@workClientToken = {{workflowClientLogin.response.body.token}}

### 8.4 Create Service Request (as Client)
# @name workflowRequest
POST {{baseUrl}}/api/service-requests
Authorization: Bearer {{workClientToken}}
Content-Type: application/json

{
    "service": "{{service1Id}}",
    "description": "Workflow test request"
}

@workRequestId = {{workflowRequest.response.body._id}}

### 8.5 Approve Request (as Admin)
PUT {{baseUrl}}/api/service-requests/{{workRequestId}}/approve
Authorization: Bearer {{adminToken}}

